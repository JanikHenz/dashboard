@import url('https://fonts.googleapis.com/css2?family=Patrick+Hand&display=swap');

:root {
  --simpson-yellow: #f7d117;
  --simpson-blue: #1271b5;
  --outline-color: #000000;
  --outline-width: 4px;
  --hard-shadow: 8px 8px 0px rgba(0, 0, 0, 0.2);
  --comic-font: 'Patrick Hand', cursive;
  --neg-shadow: inset 8px 8px 0px rgba(0, 0, 0, 0.2);
}

.app,
.power,
.threed,
button {
  border: var(--outline-width) solid var(--outline-color);
  box-shadow: var(--hard-shadow);
  border-radius: 20px 20px 20px 20px;
  transition: transform 0.1s ease;
}

button:active,
.app:active {
  transform: translate(-1px, -2px);
  box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.2);
}

body {
  font-family: 'Patrick Hand', cursive;
  color: #f7d117;
  -webkit-text-stroke: 6px black;
  paint-order: stroke fill;

  text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.5);
  letter-spacing: 1px;

  margin: 0;
  padding: 0;
  background-color: green;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

header {
  width: 100%;
  height: 9vw;
  background-color: lightslategrey;
}


.border{
  background-color: black;
  width: 100%;
  height: 100%;
  clip-path: polygon(0% 0%, 100% 0%, 100% 65%, 60% 65%, 55% 100%, 45% 100%, 40% 65%, 0% 65%);
}

.header {
  background-color: lightslategrey;
  width: 100%;
  height: 95%;
  clip-path: polygon(0% 0%, 100% 0%, 100% 60%, 60% 60%, 55% 95%, 45% 95%, 40% 60%, 0% 60%);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  border: var(--outline-width) solid var(--outline-color);
  box-shadow: var(--hard-shadow);
}

.timer {
  height: 65%;
  justify-self: start;
  display: flex;
  align-items: center;
  margin-left: 1vw;
  font-size: 2vw;
}

.mode {
  height: 65%;
  justify-self: right;
  display: flex;
  align-items: center;
  margin-right: 1vw;
  font-size: 2vw;
}

.power {
  background-color: darkgrey;
  height: 8vw;
  width: 8vw;
  border-radius: 50%;
  justify-self: center;
  align-self: center;
  font-size: 2vw;
  display: flex;
  justify-content: center;
  align-items: center;
}


.power-btn {
  height: 80%;
  width: 80%;
  background-color: green;
  border-radius: 50%;
  justify-content: center;
  align-items: center;
}

.power-icon {
  width: 60%;
  height: 60%;
  border: 6px solid white;
  border-radius: 50%;
  border-top-color: transparent;

  position: relative;
  display: inline-block;
}

.power-icon::before {
  content: "";
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 25px;
  background-color: white;
  border-radius: 2px;
}

main {
  background-color:  lightslategrey;
  width: 100%;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.apps {
  background-color: lightslategrey;
  margin: 5rem auto auto auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, 15rem);
  gap: 4rem;
  width: fit-content;
  max-width: calc(100vw - 4rem);
  padding: 4rem;
}

.app {
  background-color: burlywood;
  width: 15rem;
  height: 20rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.appinfo{
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: center;
  justify-items: center;
  max-height: 20%;
}

.status{
  height: 1rem;
  width: 1rem;
  border-radius: 50%;
  border: var(--outline-width) solid var(--outline-color);
  box-shadow: inset 4px 4px 0px rgba(0, 0, 0, 0.2);
  background-color: greenyellow;
}

.icon {
  background-color: lightcoral;
  width: 10rem;
  height: 10rem;
  margin: 1rem;
  border: var(--outline-width) solid var(--outline-color);
  box-shadow: var(--neg-shadow);
  border-radius: 20px 20px 20px 20px;
  transition: transform 0.1s ease;
}
